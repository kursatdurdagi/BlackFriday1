.hud { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.fill { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }

/* ---------- alışveriş listesi: termal fiş ---------- */
.list-panel { position: absolute; left: 26px; top: 26px; width: 340px; rotate: -1.2deg; }
.receipt { padding: 14px 20px 18px 20px; }
.receipt-store { font-size: 15px; color: rgba(43, 39, 48, 0.7); letter-spacing: 6px; -unity-text-align: middle-center; }
.receipt-title { font-size: 30px; color: #2B2730; -unity-text-align: middle-center; margin-top: -2px; letter-spacing: 1px; }
.receipt-sub { font-size: 13px; color: rgba(43, 39, 48, 0.62); -unity-text-align: middle-center; letter-spacing: 1px; }
.receipt-barcode { height: 30px; color: #2B2730; margin-top: 8px; align-self: stretch; }
.receipt-thanks { font-size: 12px; color: rgba(43, 39, 48, 0.55); -unity-text-align: middle-center; margin-top: 4px; }
.list-tape { left: 110px; top: -16px; rotate: 3deg; }

.list-row { flex-direction: row; align-items: center; height: 32px; }
.list-qty { font-size: 18px; color: rgba(43, 39, 48, 0.6); width: 30px; -unity-font-definition: url("Fonts/AnonymousPro-Bold.ttf"); }
.list-name { font-size: 20px; color: #2B2730; flex-shrink: 1; overflow: hidden; -unity-font-definition: url("Fonts/AnonymousPro-Bold.ttf"); }
.list-lead { flex-grow: 1; height: 2px; margin: 10px 6px 0 6px; border-bottom-width: 2px; border-color: rgba(43, 39, 48, 0.28); }
.list-count { font-size: 19px; color: #2B2730; flex-shrink: 0; -unity-font-definition: url("Fonts/AnonymousPro-Bold.ttf"); }
.list-check { flex-shrink: 0; width: 22px; height: 22px; margin-left: 8px; border-width: 2px; border-color: #2B2730; padding: 0; overflow: visible; }
.list-check .bf-icon { width: 30px; height: 30px; margin: -9px 0 0 -2px; color: rgba(0, 0, 0, 0); }
.list-strike { position: absolute; left: 26px; top: 15px; height: 3px; width: 0; background-color: #D7263D; rotate: -2deg; border-radius: 2px; opacity: 0.85; }
.list-row--done .list-name { color: rgba(43, 39, 48, 0.42); }
.list-row--done .list-qty { color: rgba(43, 39, 48, 0.3); }
.list-row--done .list-count { color: #D7263D; }
.list-row--done .list-check .bf-icon { color: #D7263D; }
.list-row--done .list-strike { width: 62%; }
.list-row--flash { background-color: rgba(255, 217, 28, 0.85); border-radius: 2px; margin: 0 -8px; padding: 0 8px; }
.list-flash { font-size: 13px; color: #FFFFFF; background-color: #E3262F; padding: 1px 5px; margin-left: 6px; border-radius: 2px; -unity-font-definition: url("Fonts/FiraSans-Black.ttf"); }
.list-total { font-size: 18px; color: #2B2730; letter-spacing: 2px; }

/* ---------- süre: yazar kasa LCD ---------- */
.top-center { position: absolute; top: 16px; left: 0; right: 0; align-items: center; }
.timer-box { padding: 6px 12px 10px 12px; align-items: stretch; min-width: 196px; }
.timer-caption { font-size: 12px; color: rgba(255, 255, 255, 0.55); letter-spacing: 3px; -unity-text-align: middle-center; -unity-font-definition: url("Fonts/FiraSans-Black.ttf"); margin-bottom: 4px; }
.timer-lcd { height: 70px; padding: 6px 14px; }
.timer-seg { flex-grow: 1; color: #9DFF6E; --bf-stroke: rgba(157, 255, 110, 0.07); }
.timer-box--low .timer-seg { color: #FF4B3E; --bf-stroke: rgba(255, 75, 62, 0.08); }
.timer-bar { height: 5px; margin-top: 7px; background-color: rgba(0, 0, 0, 0.55); border-radius: 2px; overflow: hidden; }
.timer-fill { height: 100%; width: 100%; background-color: #9DFF6E; }
.timer-box--low .timer-fill { background-color: #FF4B3E; }

.flash-banner { margin-top: 12px; rotate: -1.5deg; }
.flash-body { flex-direction: row; align-items: center; padding: 5px 22px 7px 8px; border-radius: 2px; }
.flash-tag { font-size: 20px; color: #E3262F; background-color: #FFD91C; padding: 0 10px; margin-right: 12px; border-radius: 2px; }
.flash-text { font-size: 25px; color: #FFFFFF; letter-spacing: 1px; }

/* ---------- puan: raf fiyat etiketi ---------- */
.top-right { position: absolute; right: 22px; top: 20px; align-items: flex-end; width: 540px; }
.score-wrap { align-items: flex-end; padding-top: 4px; }
.score-rail { position: absolute; top: 16px; right: -30px; width: 360px; height: 40px; }
.score-tag { min-width: 258px; border-radius: 2px; padding: 0 0 8px 0; rotate: 1.5deg; transform-origin: top; }
.score-head { height: 24px; justify-content: center; padding: 0 12px; border-radius: 2px 2px 0 0; }
.score-head-text { font-size: 14px; color: #FFFFFF; letter-spacing: 4px; -unity-text-align: middle-center; }
.score-body { padding: 0 16px 0 14px; align-items: flex-end; }
.score-left { margin-right: 14px; margin-bottom: 8px; }
.score-caption { font-size: 12px; color: rgba(23, 22, 27, 0.75); letter-spacing: 2px; }
.score-barcode { width: 80px; height: 24px; color: #17161B; margin-top: 4px; }
.score { font-size: 64px; color: #17161B; flex-grow: 1; -unity-text-align: lower-right; margin: -6px 0 -8px 0; }
.combo { position: absolute; left: -104px; top: 34px; width: 96px; height: 96px; -unity-background-image-tint-color: #FF7A1A; rotate: -10deg; }
.combo-text { font-size: 38px; color: #FFFFFF; margin-top: 4px; }
.combo-sub { font-size: 11px; color: #FFFFFF; letter-spacing: 2px; margin-top: -8px; }
.fps-counter { font-size: 14px; color: #9DFF6E; margin-top: 6px; -unity-font-definition: url("Fonts/AnonymousPro-Bold.ttf"); }

/* ---------- akış: kasadan çıkan küçük fiş şeritleri / anons ---------- */
.feed { margin-top: 8px; align-items: flex-end; align-self: stretch; }
.feed-item {
    flex-direction: row; align-items: center; max-width: 500px;
    background-color: #F6F2E8;
    background-image: url("Tex/paper.png"); -unity-background-image-tint-color: #F6F2E8;
    background-repeat: repeat repeat; background-size: 256px 256px;
    border-radius: 2px; border-left-width: 6px; border-color: #7A7480;
    padding: 5px 12px 5px 8px; margin-bottom: 6px;
    transition-property: opacity, translate; transition-duration: 0.35s;
}
.feed-item .bf-icon { width: 20px; height: 20px; margin-right: 8px; color: #7A7480; }
.feed-text { font-size: 16px; color: #2B2730; white-space: normal; flex-shrink: 1; -unity-font-definition: url("Fonts/FiraSans-SemiBold.ttf"); }
.feed-item--good { border-color: #1E9E50; } .feed-item--good .bf-icon { color: #1E9E50; }
.feed-item--bad { border-color: #D7263D; } .feed-item--bad .bf-icon { color: #D7263D; }
.feed-item--announce { border-color: #E3262F; background-color: #FFD91C; -unity-background-image-tint-color: #FFD91C; }
.feed-item--announce .bf-icon { color: #E3262F; }
.feed-item--announce .feed-text { color: #17161B; -unity-font-definition: url("Fonts/FiraSans-Black.ttf"); }
.feed-item--out { opacity: 0; translate: 40px 0; }

/* ---------- orta ---------- */
.crosshair { position: absolute; left: 50%; top: 50%; width: 40px; height: 40px; translate: -20px -20px; }
.center-wrap { position: absolute; left: 0; right: 0; top: 28%; align-items: center; }
.center-sticker { width: 250px; height: 250px; -unity-background-image-tint-color: #E3262F; rotate: -8deg; }
.center-big { font-size: 140px; color: #FFFFFF; margin-top: -6px; }
.center-big--text { font-size: 76px; color: #FFD91C; }

/* ---------- alt ---------- */
.bottom-center { position: absolute; left: 0; right: 0; bottom: 30px; align-items: center; }
.prompt {
    flex-direction: row; align-items: center;
    background-color: rgba(18, 18, 22, 0.88); border-radius: 4px;
    padding: 6px 4px 6px 6px; margin-bottom: 10px;
    transition-property: opacity; transition-duration: 0.15s;
}
.prompt--hidden { opacity: 0; }
/* ürün adı: küçük raf etiketi */
.prompt-title {
    font-size: 22px; color: #17161B; margin-right: 16px; padding: 2px 12px 4px 12px;
    background-color: #FFD91C; background-image: url("Tex/paper.png"); -unity-background-image-tint-color: #FFD91C;
    background-repeat: repeat repeat; background-size: 256px 256px; border-radius: 2px;
    -unity-font-definition: url("Fonts/Anton-Regular.ttf"); letter-spacing: 1px;
}
.prompt > .bf-icon { width: 22px; height: 22px; color: #FFD91C; margin: 0 8px 0 6px; }
.stamina-row { flex-direction: row; align-items: center; }
.stamina-label { font-size: 12px; color: rgba(255, 255, 255, 0.75); letter-spacing: 2px; margin-right: 8px; }
.stamina-bg { width: 220px; height: 12px; background-color: rgba(10, 14, 10, 0.85); border-radius: 2px; border-width: 1px; border-color: rgba(255, 255, 255, 0.15); overflow: hidden; padding: 2px; }
.stamina-fill { height: 100%; width: 100%; background-color: #9DFF6E; border-radius: 1px; }
.cam-mode { position: absolute; right: 22px; bottom: 22px; flex-direction: row; align-items: center; background-color: rgba(18, 18, 22, 0.85); border-radius: 4px; padding: 5px 6px 5px 12px; }
.cam-mode-text { font-size: 15px; color: #FFFFFF; margin-right: 10px; letter-spacing: 1px; }

/* ---------- dünya işaretleri ---------- */
.name-tag { position: absolute; font-size: 16px; translate: -50% -100%; background-color: rgba(18, 18, 22, 0.82); border-radius: 3px; padding: 1px 9px; }
.marker { position: absolute; translate: -50% -100%; align-items: center; }
.marker-box {
    flex-direction: row; align-items: center;
    background-image: url("Tex/lightbox.png"); -unity-slice-left: 12; -unity-slice-right: 12; -unity-slice-top: 12; -unity-slice-bottom: 12;
    -unity-background-image-tint-color: #2BD46A;
    padding: 5px 12px 6px 10px;
}
.marker-kasa { font-size: 18px; color: #FFFFFF; background-color: #17161B; padding: 0 7px; border-radius: 2px; margin-right: 8px; -unity-font-definition: url("Fonts/Anton-Regular.ttf"); letter-spacing: 1px; }
.marker-text { font-size: 18px; color: #0E2A16; -unity-font-definition: url("Fonts/FiraSans-Black.ttf"); }
.marker-pole { width: 4px; height: 14px; background-color: #2A2A30; }

/* ---------- lobi: karton tabela ---------- */
.lobby-panel { position: absolute; left: 50%; top: 168px; width: 780px; translate: -390px 0; rotate: -0.6deg; }
.lobby-body { padding: 0 32px 26px 30px; }
.lobby-ribbon { align-self: flex-start; margin: 0 0 8px -30px; padding: 4px 16px 5px 30px; border-radius: 0 2px 2px 0; }
.lobby-ribbon-text { font-size: 15px; color: #FFFFFF; letter-spacing: 2px; }
.lobby-title { font-size: 58px; color: #1E1A16; letter-spacing: 1px; margin-top: 4px; }
.lobby-mode { color: #8E1C24; font-size: 17px; -unity-font-definition: url("Fonts/FiraSans-Black.ttf"); letter-spacing: 1px; }
.lobby-story { font-size: 19px; color: #2A231C; white-space: normal; margin: 6px 0 12px 0; -unity-font-definition: url("Fonts/FiraSans-SemiBold.ttf"); }
.lobby-count { font-size: 26px; color: #1E1A16; letter-spacing: 1px; }
.lobby-tape-l { left: -34px; top: -6px; rotate: -32deg; }
.lobby-tape-r { right: -34px; top: -6px; rotate: 32deg; }
.player-chip { flex-direction: row; align-items: center; background-color: #F6F2E8; border-radius: 2px; padding: 3px 12px 3px 5px; margin: 0 8px 6px 0; }
.player-dot { width: 18px; height: 18px; border-radius: 9px; margin-right: 8px; border-width: 2px; border-color: #1E1A16; }
.player-name { font-size: 18px; color: #1E1A16; }
.controls-grid { flex-direction: row; flex-wrap: wrap; margin-top: 10px; }
.control { flex-direction: row; align-items: center; width: 33%; margin-bottom: 7px; }

/* ---------- bitiş: kasa fişi ---------- */
.end-panel { position: absolute; left: 50%; top: 60px; width: 600px; translate: -300px 0; align-items: center; }
.end-receipt-wrap { width: 520px; rotate: 0.8deg; }
.end-receipt { padding: 22px 32px 22px 32px; align-items: stretch; }
.end-head { font-size: 46px; color: #2B2730; letter-spacing: 6px; -unity-text-align: middle-center; }
.end-line { flex-direction: row; height: 28px; align-items: center; }
.end-line-name { font-size: 18px; color: #2B2730; flex-grow: 1; -unity-font-definition: url("Fonts/AnonymousPro-Bold.ttf"); }
.end-line-val { font-size: 18px; color: #2B2730; -unity-font-definition: url("Fonts/AnonymousPro-Bold.ttf"); }
.end-line--bad .end-line-val { color: #D7263D; }
.end-line--bonus .end-line-val { color: #1E9E50; }
.end-total-name { font-size: 34px; color: #2B2730; flex-grow: 1; letter-spacing: 2px; }
.end-total-val { font-size: 44px; color: #2B2730; }
.end-stars { height: 84px; width: 280px; align-self: center; color: #FFB800; --bf-stroke: rgba(43, 39, 48, 0.16); margin-top: 6px; }
.end-detail { font-size: 15px; color: rgba(43, 39, 48, 0.75); white-space: normal; -unity-text-align: middle-center; margin-top: 4px; }
.end-stamp-wrap { position: absolute; right: 22px; top: 150px; rotate: 14deg; }
.end-stamp { font-size: 30px; color: #D7263D; border-width: 4px; border-color: #D7263D; border-radius: 6px; padding: 0 14px 2px 14px; letter-spacing: 2px; opacity: 0.88; }
.end-stamp--win { color: #1E9E50; border-color: #1E9E50; }
.stamp-wear { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-image: url("Tex/grunge.png"); -unity-background-image-tint-color: #F6F2E8; background-repeat: repeat repeat; background-size: 256px 256px; }
.end-buttons { flex-direction: row; margin-top: 24px; }
.end-buttons .bf-button { min-width: 240px; margin: 0 8px; }

/* ---------- mola ---------- */
.pause-panel { position: absolute; left: 50%; top: 170px; width: 600px; translate: -300px 0; rotate: 0.5deg; }
.pause-body { padding: 18px 32px 26px 30px; }
.pause-title { font-size: 52px; }
.pause-tape { left: 240px; top: -18px; rotate: -4deg; }
.dim { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(8, 8, 12, 0.55); }
